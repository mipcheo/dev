{
  "name": "@mipcheo/eslint",
  "version": "1.0.0",
  "type": "module",
  "description": "Opinionated, standards-based ESLint flat configs for TypeScript, React and Next.js",
  "license": "MIT",
  "author": "Thuan Dao",
  "exports": {
    ".": "./src/index.js",
    "./*": "./src/configs/*.js"
  },
  "scripts": {
    "check": "tsc --noEmit && eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-mdx": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:peers"
  },
  "repository": {
    "type": "git",
    "directory": "packages/eslint",
    "url": "git+https://github.com/mipcheo/dev.git"
  },
  "homepage": "https://github.com/mipcheo/dev/tree/main/packages/eslint#readme",
  "bugs": {
    "url": "https://github.com/mipcheo/dev/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "typescript",
    "react",
    "nextjs"
  ]
}
