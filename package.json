{
  "name": "@mipcheo/dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "format": "prettier --write .",
    "check": "prettier --check . && pnpm --recursive --if-present run check",
    "test": "pnpm --recursive --if-present run test",
    "pack": "pnpm --recursive pack --pack-destination out"
  },
  "devDependencies": {
    "@mipcheo/eslint": "workspace:*",
    "@mipcheo/prettier": "workspace:*",
    "@mipcheo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
