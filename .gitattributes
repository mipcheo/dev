# Normalize all text files to LF, in the repo and in the working tree, whatever the OS or editor.

* text=auto eol=lf

# Git holds text only: every binary format goes through Git LFS, so a commit carries a small pointer and the file lives in the store

# Audio
*.m4a filter=lfs diff=lfs merge=lfs -text
*.aac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
